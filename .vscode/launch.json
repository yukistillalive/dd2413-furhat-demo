{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vision：模拟调试（无需机器人）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/vision_debug.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": ["--simulate"],
      "cwd": "${workspaceFolder}/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Vision：Furhat 1（仅用户数据）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/vision_debug.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": ["--host", "192.168.1.114"],
      "cwd": "${workspaceFolder}/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
